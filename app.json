      "targetSdkVersion": 36,
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050510"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ff0564ff-e19d-4a9a-bb77-f9d8d395a469"
      }
    }
  }
